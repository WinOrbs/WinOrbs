{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "matches": {
      "$roomId": {
        "result": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('matches').child($roomId).child('host').child('heartbeatAt').exists() && root.child('matches').child($roomId).child('host').child('uid').val() === auth.uid && now - root.child('matches').child($roomId).child('host').child('heartbeatAt').val() <= 8000"
        },
        "host": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || !data.child('heartbeatAt').exists() || data.child('uid').val() === auth.uid || now - data.child('heartbeatAt').val() > 8000)"
        },
        "players": {
          "$playerId": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $playerId",
            ".validate": "newData.hasChildren(['id', 'name', 'x', 'y', 'score', 'mass', 'radius', 'angle', 'kills', 'isAlive', 'boostActive', 'updatedAt'])"
          }
        },
        "world": {
          ".read": "auth != null",
          ".write": "auth != null && (!root.child('matches').child($roomId).child('host').child('heartbeatAt').exists() || auth.uid === root.child('matches').child($roomId).child('host').child('uid').val() || now - root.child('matches').child($roomId).child('host').child('heartbeatAt').val() > 8000)",
          ".validate": "newData.hasChildren(['orbs', 'players', 'updatedAt'])"
        }
      }
    }
  }
}