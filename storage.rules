rules_version = '2';

// ─────────────────────────────────────────────────────────────
// REGLAS DE FIREBASE STORAGE — WinOrbs (⚠️ ARCHIVO OBSOLETO / NO USAR)
//
// POR QUÉ QUEDÓ INACTIVO: subir archivos a Cloud Storage for Firebase exige el
// plan Blaze (de pago) incluso para el bucket por defecto, así que en el plan
// Spark todas las subidas fallaban y las imágenes (skins y comprobantes) se
// guardaban SIN imagen. Por eso la subida se movió a Cloudinary:
//   · public/js/media-config.js  → host, preset y carpeta
//   · public/admin.html          → subirSkinImg()  (imagen de la skin)
//   · public/wallet.html         → subirComprobante() (comprobante de depósito)
//
// Solo hay que volver a publicar estas reglas SI algún día se habilita Blaze y
// se decide regresar a Firebase Storage. Contenido original (por si se retoma):
//
// Cada usuario sube SOLO a su propia carpeta comprobantes/{uid}/,
// imágenes de menos de 5 MB. Cualquier usuario autenticado puede
// leer (necesario para que el admin abra el enlace del comprobante).
// ─────────────────────────────────────────────────────────────
service firebase.storage {
  match /b/{bucket}/o {
    match /comprobantes/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ── Imágenes de skins de la tienda (solo admin sube; autenticados leen) ──
    // PNG/JPG/GIF de menos de 5 MB, en la carpeta skins/. El UID y email de
    // admin son los mismos que en firestore.rules → isAdmin().
    match /skins/{fileName} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
                            && (request.auth.token.email == "winorbs@admins.com")
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
    }
  }
}